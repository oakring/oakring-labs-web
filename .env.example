# PostgreSQL (Supabase connection string) — required for waitlist
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Resend — waitlist confirmation emails (optional locally; required in production to send mail)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="OakRing Labs <hello@yourdomain.com>"

# Optional: Slack/Discord webhook when someone joins the waitlist
FOUNDER_NOTIFY_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Public site URL (metadata, emails, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://oakringlabs.com"

# Set automatically by Next.js / Node — do not put secrets here
# NODE_ENV=development
